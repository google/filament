material {
    name : blitArray,
    parameters : [
        {
            type : sampler2dArray,
            name : color,
            precision: medium
        },
        {
            type : int,
            name : layerIndex
        },
        {
            type : float,
            name : levelOfDetail,
        },
        {
            type : float4,
            name : viewport,
            precision: high
        }
    ],
    variables : [
        vertex
    ],
    constants : [
        {
            type : bool,
            name : multiview
        }
    ],
    depthWrite : false,
    depthCulling : false,
    domain: postprocess
}

vertex {
    void postProcessVertex(inout PostProcessVertexInputs postProcess) {
        postProcess.vertex.xy = materialParams.viewport.xy + postProcess.normalizedUV * materialParams.viewport.zw;
        postProcess.vertex.xy = uvToRenderTargetUV(postProcess.vertex.xy);
    }
}

fragment {
    void postProcess(inout PostProcessInputs postProcess) {
        float layer = float(materialParams.layerIndex);
        if (materialConstants_multiview) {
            // A multiview target gives each eye its own layer of the source. This mirrors
            // getEyeIndex(), which is unavailable here because post-process variants never carry
            // VARIANT_HAS_STEREO.
#if defined(FILAMENT_STEREO_MULTIVIEW)
#   if defined(TARGET_VULKAN_ENVIRONMENT)
            layer = float(gl_ViewIndex);
#   else
            layer = float(gl_ViewID_OVR);
#   endif
#endif
        }
        postProcess.color = textureLod(materialParams_color, vec3(variable_vertex.xy, layer), materialParams.levelOfDetail);
    }
}
