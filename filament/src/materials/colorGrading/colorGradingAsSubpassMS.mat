material {
    name : colorGradingAsSubpassMS,
    parameters : [
        {
            type : sampler3d,
            name : lut,
            precision: medium
        },
        {
            type : float2,
            name : lutSize
        },
        {
            type : int,
            name : dithering
        },
        {
            type : int,
            name : outputLuminance
        },
        {
            type : float,
            name : temporalNoise,
            precision: high
        },
        {
            type : float4,
            name : vignette
        },
        {
            type : float4,
            name : vignetteColor
        },
        {
            type : int,
            name : sampleCount
        }
    ],
    constants : [
        {
            type : bool,
            name : isOneDimensional
        },
        {
            type : bool,
            name : isLDR
        }
    ],
    subpasses : [
        {
            type : subpassInputMS,
            format : float,
            precision : medium,
            name : colorBuffer,
        }
    ],
    outputs : [
        {
            name : tonemappedOutput,
            target : color,
            type : float4,
            location : 0
        }
    ],
    variables : [
        vertex
    ],
    depthWrite : false,
    depthCulling : false,
    domain: postprocess,
    framebufferFetch: true
}

vertex {
    void postProcessVertex(inout PostProcessVertexInputs postProcess) {
        postProcess.vertex.xy = postProcess.normalizedUV;
    }
}

fragment {
vec4 resolveFragment() {
#ifdef TARGET_WEBGPU_ENVIRONMENT
    return vec4(0.0, 0.0, 0.0, 1.0);
#else
    vec4 color = vec4(0.0);
    for (int sampleIndex = 0; sampleIndex < materialParams.sampleCount; ++sampleIndex) {
        color += subpassLoad(materialParams_colorBuffer, sampleIndex);
    }
    color *= 1.0 / float(materialParams.sampleCount);
#if POST_PROCESS_OPAQUE
    return vec4(color.rgb, 1.0);
#else
    color.rgb *= 1.0 / (color.a + FLT_EPS);
    return color;
#endif
#endif
}
#include "colorGradingAsSubpass.fs"
}
