action("litert_lm_advanced_main") {
  script = "build_litert_lm.py"
  args =
      [ rebase_path("$root_out_dir/litert_lm_advanced_main", root_build_dir) ]
  outputs = [ "$root_out_dir/litert_lm_advanced_main" ]
  inputs = [ "build_litert_lm.py" ]
  if (is_linux) {
    inputs += [ "$root_out_dir/libwebgpu_dawn.so" ]
    if (target_cpu == "x64") {
      inputs += [
        "data/prebuilt/linux_x86_64/libGemmaModelConstraintProvider.so",
        "data/prebuilt/linux_x86_64/libLiteRt.so",
        "data/prebuilt/linux_x86_64/libLiteRtTopKWebGpuSampler.so",
        "data/prebuilt/linux_x86_64/libLiteRtWebGpuAccelerator.so",
      ]
    } else if (target_cpu == "arm64") {
      inputs += [
        "data/prebuilt/linux_arm64/libGemmaModelConstraintProvider.so",
        "data/prebuilt/linux_arm64/libLiteRt.so",
        "data/prebuilt/linux_arm64/libLiteRtTopKWebGpuSampler.so",
        "data/prebuilt/linux_arm64/libLiteRtWebGpuAccelerator.so",
      ]
    }
  }
  if (is_mac) {
    inputs += [
      "$root_out_dir/libwebgpu_dawn.dylib",
      "data/prebuilt/macos_arm64/libGemmaModelConstraintProvider.dylib",
      "data/prebuilt/macos_arm64/libLiteRt.dylib",
      "data/prebuilt/macos_arm64/libLiteRtTopKWebGpuSampler.dylib",
      "data/prebuilt/macos_arm64/libLiteRtWebGpuAccelerator.dylib",
    ]
  }
  deps = [ "//src/dawn/native:webgpu_dawn_shared" ]
  data = [
    "data/model.litertlm",
    "//scripts/run_litert_lm_benchmark.py",
    "$root_out_dir/litert_lm_advanced_main",
  ]
  if (is_linux) {
    outputs += [
      "$root_out_dir/libGemmaModelConstraintProvider.so",
      "$root_out_dir/libLiteRt.so",
      "$root_out_dir/libLiteRtTopKWebGpuSampler.so",
      "$root_out_dir/libLiteRtWebGpuAccelerator.so",
    ]
    data += [
      "$root_out_dir/libGemmaModelConstraintProvider.so",
      "$root_out_dir/libLiteRt.so",
      "$root_out_dir/libLiteRtTopKWebGpuSampler.so",
      "$root_out_dir/libLiteRtWebGpuAccelerator.so",
    ]
  }
}
