implicit(C: iu32) fn textureStore(texture: texture_storage_2d<i32_texel_format, writable>,
                          coords: vec2<C>,
                           value: vec4<i32>)
implicit(C: iu32) fn textureStore(texture: texture_storage_2d_array<i32_texel_format, writable>,
                          coords: vec3<C>,
                           value: vec4<i32>)
implicit(C: iu32) fn textureStore(texture: texture_storage_3d<i32_texel_format, writable>,
                          coords: vec3<C>,
                           value: vec4<i32>)
implicit(C: iu32) fn textureStore(texture: texture_storage_1d<u32_texel_format, writable>,
                          coords: C,
                           value: vec4<u32>)
implicit(C: iu32) fn textureStore(texture: texture_storage_2d<u32_texel_format, writable>,
                          coords: vec2<C>,
                           value: vec4<u32>)
implicit(C: iu32) fn textureStore(texture: texture_storage_2d_array<u32_texel_format, writable>,
                          coords: vec3<C>,
                           value: vec4<u32>)
implicit(C: iu32) fn textureStore(texture: texture_storage_3d<u32_texel_format, writable>,
                          coords: vec3<C>,
                           value: vec4<u32>)

fn unpack_s8s32(int8_t4_packed) -> vec4<i32>
fn unpack_u8u32(uint8_t4_packed) -> vec4<u32>

fn WaveGetLaneIndex() -> u32
fn WaveGetLaneCount() -> u32
implicit(T: fiu32_f16) fn WaveReadLaneAt(T, u32) -> T
implicit(N: num, T: fiu32_f16) fn WaveReadLaneAt(vec<N, T>, u32) -> vec<N, T>

implicit(T: f32_f16) fn modf(T, T) -> T
implicit(N: num, T: f32_f16) fn modf(vec<N, T>, vec<N, T>) -> vec<N, T>

implicit(T: f32_f16) fn frexp(T, T) -> T
implicit(N: num, T: f32_f16) fn frexp(vec<N, T>, vec<N, T>) -> vec<N, T>

implicit(T: scalar) fn select(bool, T, T) -> T
implicit(T: scalar, N: num) fn select(bool, vec<N, T>, vec<N, T>) -> vec<N, T>
implicit(N: num, T: scalar) fn select(vec<N, bool>, vec<N, T>, vec<N, T>) -> vec<N, T>

@must_use @stage("compute") implicit(T: f16, C: num, R: num, K: num)
  fn Multiply<TR: f32_f16>(subgroup_matrix<subgroup_matrix_kind_left, T, K, R>,
                           subgroup_matrix<subgroup_matrix_kind_right, T, C, K>)
      -> subgroup_matrix<subgroup_matrix_kind_result, TR, C, R>

@must_use @stage("compute") implicit(T: f32, C: num, R: num, K: num)
  fn Multiply<TR: f32>(subgroup_matrix<subgroup_matrix_kind_left, T, K, R>,
                       subgroup_matrix<subgroup_matrix_kind_right, T, C, K>)
      -> subgroup_matrix<subgroup_matrix_kind_result, TR, C, R>

@must_use @stage("compute") implicit(T: iu8, C: num, R: num, K: num)
  fn Multiply<TR: iu32_iu8>(subgroup_matrix<subgroup_matrix_kind_left, T, K, R>,
                            subgroup_matrix<subgroup_matrix_kind_right, T, C, K>)
      -> subgroup_matrix<subgroup_matrix_kind_result, TR, C, R>

@must_use @stage("compute") implicit(T: iu32, C: num, R: num, K: num)
  fn Multiply<TR: iu32>(subgroup_matrix<subgroup_matrix_kind_left, T, K, R>,
                        subgroup_matrix<subgroup_matrix_kind_right, T, C, K>)
      -> subgroup_matrix<subgroup_matrix_kind_result, TR, C, R>

@member_function implicit(T: f16, TR: f32_f16, C: num, R: num, K: num)
  fn MultiplyAccumulate(ptr<function, subgroup_matrix<subgroup_matrix_kind_result, TR, C, R>, read_write>,
                         subgroup_matrix<subgroup_matrix_kind_left, T, K, R>,
                         subgroup_matrix<subgroup_matrix_kind_right, T, C, K>)

@member_function implicit(T: f32, TR: f32, C: num, R: num, K: num)
  fn MultiplyAccumulate(ptr<function, subgroup_matrix<subgroup_matrix_kind_result, TR, C, R>, read_write>,
                         subgroup_matrix<subgroup_matrix_kind_left, T, K, R>,
                         subgroup_matrix<subgroup_matrix_kind_right, T, C, K>)

@member_function implicit(T: iu8, TR: iu32_iu8, C: num, R: num, K: num)
  fn MultiplyAccumulate(ptr<function, subgroup_matrix<subgroup_matrix_kind_result, TR, C, R>, read_write>,
                         subgroup_matrix<subgroup_matrix_kind_left, T, K, R>,
                         subgroup_matrix<subgroup_matrix_kind_right, T, C, K>)

@member_function implicit(T: iu32, TR: iu32, C: num, R: num, K: num)
  fn MultiplyAccumulate(ptr<function, subgroup_matrix<subgroup_matrix_kind_result, TR, C, R>, read_write>,
                         subgroup_matrix<subgroup_matrix_kind_left, T, K, R>,
                         subgroup_matrix<subgroup_matrix_kind_right, T, C, K>)

@member_function implicit(K: subgroup_matrix_kind, T: fiu32_f16, C: num, R: num)
  fn Get(subgroup_matrix<K, T, C, R>, index: u32) -> T

@member_function implicit(K: subgroup_matrix_kind, T: fiu32_f16, C: num, R: num)
  fn Set(ptr<function, subgroup_matrix<K, T, C, R>, read_write>, index: u32, value: T)

@member_function implicit(K: subgroup_matrix_kind, T: subgroup_matrix_component_types, C: num, R: num)
  fn Length(ptr<function, subgroup_matrix<K, T, C, R>, read_write>) -> u32

@member_function implicit(K: subgroup_matrix_kind, T: i8, C: num, R: num)
  fn Cast<TR: i32>(subgroup_matrix<K, T, C, R>) -> subgroup_matrix<K, TR, C, R>

@member_function implicit(K: subgroup_matrix_kind, T: i32, C: num, R: num)
  fn Cast<TR: i8>(subgroup_matrix<K, T, C, R>) -> subgroup_matrix<K, TR, C, R>

@member_function implicit(K: subgroup_matrix_kind, T: u8, C: num, R: num)
  fn Cast<TR: u32>(subgroup_matrix<K, T, C, R>) -> subgroup_matrix<K, TR, C, R>

@member_function implicit(K: subgroup_matrix_kind, T: u32, C: num, R: num)
  fn Cast<TR: u8>(subgroup_matrix<K, T, C, R>) -> subgroup_matrix<K, TR, C, R>

