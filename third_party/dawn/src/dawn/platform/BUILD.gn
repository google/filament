import("../../../scripts/dawn_overrides_with_defaults.gni")

import("${dawn_root}/scripts/dawn_component.gni")

config("dawn_perfetto_config") {
  if (dawn_enable_perfetto) {
    defines = [ "DAWN_USE_PERFETTO" ]

    configs = [ "$dawn_perfetto_dir/gn:public_config" ]
  }
}

if (build_with_chromium) {
  group("dawn_perfetto") {
    if (dawn_enable_perfetto) {
      # When build_with_chromium=true we need to include the combined target
      # to avoid multiply defined globals.
      public_deps = [ "$dawn_perfetto_dir:libperfetto" ]
      public_configs = [ ":dawn_perfetto_config" ]
    }
  }
} else {
  component("dawn_perfetto") {
    if (dawn_enable_perfetto) {
      # In standalone builds, use the client API. A component is required in
      # component builds to avoid duplicate symbol errors across Dawn DLLs.
      public_deps = [ "$dawn_perfetto_dir/src/tracing:client_api" ]
      public_configs = [ ":dawn_perfetto_config" ]
    }
  }
}

dawn_component("platform") {
  DEFINE_PREFIX = "DAWN_PLATFORM"

  configs = [ "${dawn_root}/src/dawn/common:internal_config" ]

  sources = [
    "${dawn_root}/include/dawn/platform/DawnPlatform.h",
    "${dawn_root}/include/dawn/platform/dawn_platform_export.h",
    "DawnPlatform.cpp",
    "WorkerThread.cpp",
    "WorkerThread.h",
    "metrics/HistogramMacros.cpp",
    "metrics/HistogramMacros.h",
    "tracing/TraceEvent.h",
  ]

  if (dawn_enable_perfetto) {
    sources += [
      "tracing/trace_categories.cc",
      "tracing/trace_categories.h",
    ]
  }

  deps = [ "${dawn_root}/src/dawn/common" ]
  if (dawn_use_built_dxc) {
    defines = [ "DAWN_USE_BUILT_DXC" ]
  }

  public_deps = [
    ":dawn_perfetto",

    # DawnPlatform.h has #include <webgpu/webgpu.h>
    "${dawn_root}/include/dawn:headers",
    "${dawn_root}/src/dawn/partition_alloc:raw_ptr",
  ]
}
